      "metadata": {},
      "outputs": [],
      "source": [
        "# Evaluate on validation set\n",
        "def normalize_sql(sql: str) -> str:\n",
        "    \"\"\"Normalize SQL for comparison (remove extra whitespace, lowercase keywords).\"\"\"\n",
        "    # Note: re is already imported at the top\n",
        "    # Remove extra whitespace\n",
        "    sql = re.sub(r'\\s+', ' ', sql.strip())\n",
        "    # Remove trailing semicolons for comparison\n",
        "    sql = sql.rstrip(';').strip()\n",
        "    return sql\n",
        "\n",
        "# Get validation examples - create a mapping\n",
        "val_indices = []\n",
        "for i, formatted_item in enumerate(formatted_data):\n",
        "    if formatted_item in val_data:\n",
        "        val_indices.append(i)\n",
        "\n",
        "val_df = df.iloc[val_indices].copy()\n",
        "\n",
        "correct = 0\n",
        "total = len(val_df)\n",
        "\n",
        "print(f\"Evaluating on {total} validation examples...\\n\")\n",
        "\n",
        "results = []\n",
        "for idx, row in val_df.iterrows():\n",
        "    question = row['question']\n",
        "    expected_sql = row['expected_sql']\n",
        "    \n",
        "    generated_sql = generate_sql(question, fine_tuned_model, tokenizer)\n",
        "    \n",
        "    # Normalize for comparison\n",
        "    expected_normalized = normalize_sql(expected_sql)\n",
        "    generated_normalized = normalize_sql(generated_sql)\n",
        "    \n",
        "    is_correct = expected_normalized.lower() == generated_normalized.lower()\n",
        "    if is_correct:\n",
        "        correct += 1\n",
        "    \n",
        "    results.append({\n",
        "        'question': question,\n",
        "        'expected_sql': expected_sql,\n",
        "        'generated_sql': generated_sql,\n",
        "        'correct': is_correct\n",
        "    })\n",
        "    \n",
        "    if not is_correct:\n",
        "        print(f\"\\nQuestion: {question}\")\n",
        "        print(f\"Expected: {expected_sql}\")\n",
        "        print(f\"Generated: {generated_sql}\")\n",
        "        print(f\"Match: {is_correct}\")\n",
        "\n",
        "accuracy = (correct / total) * 100\n",
        "print(f\"\\n{'='*80}\")\n",
        "print(f\"Validation Accuracy: {accuracy:.2f}% ({correct}/{total})\")\n",
        "print(f\"{'='*80}\")"
      ]
